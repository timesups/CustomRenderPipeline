{
  // Unity 项目：侧边栏与搜索只聚焦源码与配置，隐藏生成物
  "files.exclude": {
    "**/.DS_Store": true,
    "**/.git": true,
    "**/.vs": true,
    "**/Library": true,
    "**/Temp": true,
    "**/Logs": true,
    "**/obj": true,
    "**/Build": true,
    "**/Builds": true,
    "**/BuildTest": true,
    "**/MemoryCaptures": true,
    "**/Recordings": true,
    "**/UserSettings": true,
    "**/*.csproj": true,
    "**/*.sln": true,
    "**/*.suo": true,
    "**/*.user": true,
    "**/*.userprefs": true,
    "**/*.pidb": true,
    "**/*.booproj": true,
    "**/*.svd": true,
    "**/*.pdb": true,
    "**/*.mdb": true,
    "**/*.opendb": true,
    "**/*.VC.db": true,
    "**/*.meta": true
  },
  "search.exclude": {
    "**/Library": true,
    "**/Temp": true,
    "**/Logs": true,
    "**/obj": true,
    "**/Build": true,
    "**/Builds": true,
    "**/BuildTest": true,
    "**/MemoryCaptures": true,
    "**/Recordings": true,
    "**/UserSettings": true,
    "**/.vs": true,
    "**/*.csproj": true,
    "**/*.sln": true,
    "**/*.meta": true,
    "**/Packages/packages-lock.json": true
  },
  "files.watcherExclude": {
    "**/Library/**": true,
    "**/Temp/**": true,
    "**/Logs/**": true,
    "**/obj/**": true,
    "**/Build/**": true,
    "**/Builds/**": true,
    "**/BuildTest/**": true,
    "**/UserSettings/**": true,
    "**/.vs/**": true
  },
  "files.associations": {
    "*.hlsl": "hlsl",
    "*.shader": "hlsl",
    "*.compute": "hlsl",
    "*.cginc": "hlsl"
  },
  "dotnet.defaultSolution": "CustomRenderPipeline.sln",
  "omnisharp.useModernNet": true,
  "editor.formatOnSave": false,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true
}
